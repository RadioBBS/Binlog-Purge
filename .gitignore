# Binlog-Purge – Git-Ignore-Liste.
#
# Projekt:     Binlog-Purge
# Modul:       .gitignore
# Version:     1.1.1
# Stand:       2026-11-02
# Abhaengig:   Python >= 3.11; MariaDB-Client mariadb oder mysql
# Bezug:       requirements.txt
# Lizenz:      MIT
# Upstream:    –
# Erstellt mit: Cursor Grok 4.6
# Autor:       (FFHB) / RadioBBS
#
# Historie
# --------
# Version 1.0.0 – 2026-09-03 – Logs, venv, lokale Ordner
# Version 1.1.1 – 2026-11-02 – Startausgabe und Python 3.11 nach Styleguide 2.1.0.

__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.env

# Logs / lokale Ausgaben
*.log
*.tmp

# Lokale Testdaten (Styleguide 1.4.0)
__local__/
__scratch__/
__testdata__/

# Zugangsdaten (nie committen)
credentials.txt
*.credentials

# IDE / OS
.idea/
.vscode/
*.swp
Thumbs.db
Desktop.ini
.DS_Store
